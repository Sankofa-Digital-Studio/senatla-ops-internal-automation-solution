SENATLA_API_MODE=supabase
SENATLA_API_BASE_URL=http://localhost:4200
SENATLA_SUPABASE_URL=https://your-project.supabase.co
SENATLA_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SENATLA_PROVISIONING_EMAIL_WEBHOOK_URL=https://your-email-service.example/provision-user
SENATLA_PROVISIONING_EMAIL_WEBHOOK_TOKEN=your-email-webhook-token
SENATLA_APP_URL=http://localhost:4200
SENATLA_CANONICAL_ORIGIN=https://senatla-ops.vercel.app
# Hosted UAT must set SENATLA_DEPLOYMENT_ENV=preview and use https://senatla-ops-uat.vercel.app.
# Hosted builds must set SENATLA_APPROVED_SUPABASE_PROJECT_REF to the approved project ref.
# Leave blank to disable optional analytics completely.
SENATLA_GA4_MEASUREMENT_ID=
