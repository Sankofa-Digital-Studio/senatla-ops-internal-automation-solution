{
  "name": "senatla-ops",
  "version": "0.5.4",
  "author": "Sankofa Digital Studio",
  "homepage": "https://senatla-ops.vercel.app",
  "scripts": {
    "ng": "ng",
    "predev": "node scripts/write-runtime-config.mjs",
    "dev": "ng serve --host 0.0.0.0 --port 3000 --allowed-hosts",
    "prestart": "node scripts/write-runtime-config.mjs",
    "start": "ng serve --host 0.0.0.0 --port 3000 --allowed-hosts",
    "prebuild": "node scripts/write-runtime-config.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration=ci --browsers=ChromeHeadlessCI --watch=false --progress=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && npm run typecheck:api",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "lint": "ng lint",
    "test:runtime-config": "node --test scripts/write-runtime-config.test.mjs",
    "test:ocr-device-uat-contract": "node --test scripts/ocr-device-uat-contract.test.mjs",
    "test:admin-users-reset-contract": "node --test scripts/admin-users-reset-contract.test.mjs",
    "provision:users": "node scripts/provision-users.mjs",
    "test:provision-users": "node --test scripts/provision-users.test.mjs",
    "test:password-change-complete-contract": "node --test scripts/password-change-complete-contract.test.mjs",
    "test:profile-recovery-contract": "node --test scripts/profile-recovery-contract.test.mjs",
    "validate:ocr-device-uat": "node scripts/validate-ocr-device-uat.mjs",
    "docker:ensure": "node scripts/ensure-docker.mjs",
    "test:docker-ensure": "node --test scripts/ensure-docker.test.mjs",
    "supabase:start": "npm run docker:ensure && supabase start --ignore-health-check --exclude analytics,vector",
    "supabase:status": "npm run docker:ensure && supabase status",
    "supabase:reset": "npm run docker:ensure && supabase db reset",
    "supabase:test": "npm run docker:ensure && supabase test db",
    "supabase:stop": "supabase stop",
    "test:responsive": "playwright test",
    "test:hosted": "playwright test --config=playwright.hosted.config.ts",
    "test:e2e:cypress": "cypress run",
    "native:sync:android": "cap sync android",
    "native:sync:ios": "cap sync ios && node scripts/normalize-capacitor-spm-paths.mjs",
    "test:download-apk-contract": "node --test scripts/download-apk-contract.test.mjs",
    "test:pwa-manifest-contract": "node --test scripts/pwa-manifest-contract.test.mjs",
    "validate:release-health": "node scripts/validate-release-health.mjs",
    "test:release-health": "node --test scripts/validate-release-health.test.mjs",
    "test:password-policy": "node --test scripts/password-policy.test.mjs",
    "seed:users": "node scripts/seed-operational-users.mjs",
    "test:seed-users": "node --test scripts/seed-operational-users.test.mjs",
    "test:recovery-pin-contract": "node --test scripts/recovery-pin-contract.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor/android": "8.6.0",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@supabase/supabase-js": "2.119.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.20.0",
    "eslint": "^10.6.0",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.25",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "description": "Internal operations control platform for Senatla Trading",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@15.21.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
