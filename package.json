{
  "name": "senatla-ops",
  "version": "0.5.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-runtime-config.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/write-runtime-config.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration=ci --browsers=ChromeHeadlessCI --watch=false --progress=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "lint": "ng lint",
    "ion": "ionic serve",
    "test:runtime-config": "node --test scripts/write-runtime-config.test.mjs",
    "test:ocr-device-uat-contract": "node --test scripts/ocr-device-uat-contract.test.mjs",
    "test:admin-users-reset-contract": "node --test scripts/admin-users-reset-contract.test.mjs",
    "validate:ocr-device-uat": "node scripts/validate-ocr-device-uat.mjs",
    "docker:ensure": "node scripts/ensure-docker.mjs",
    "test:docker-ensure": "node --test scripts/ensure-docker.test.mjs",
    "supabase:start": "npm run docker:ensure && supabase start --ignore-health-check --exclude analytics,vector",
    "supabase:status": "npm run docker:ensure && supabase status",
    "supabase:reset": "npm run docker:ensure && supabase db reset",
    "supabase:test": "npm run docker:ensure && supabase test db",
    "supabase:stop": "supabase stop",
    "test:responsive": "playwright test",
    "test:e2e:cypress": "cypress run",
    "native:sync:android": "cap sync android",
    "native:sync:ios": "cap sync ios && node scripts/normalize-capacitor-spm-paths.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "^8.0.0",
    "@supabase/supabase-js": "2.112.2",
    "ionicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@capacitor/cli": "8.5.0",
    "@ionic/angular-toolkit": "^12.0.0",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "24.13.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.20.0",
    "eslint": "^10.6.0",
    "jasmine-core": "~6.3.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.25",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "description": "An Ionic project",
  "overrides": {
    "xcode": { "uuid": "11.1.1" }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@15.20.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
