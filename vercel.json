{
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/assets/runtime-config.json",
      "destination": "/assets/runtime-config.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
